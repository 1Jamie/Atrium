{
  "name": "atrium",
  "version": "0.5.0-devel.1",
  "description": "Lotus Atrium — nested compositor / Steam launch wrapper (consumer of @lotus-gui/core)",
  "private": true,
  "bin": {
    "atrium": "./bin/atrium",
    "atrium-dev": "./bin/atrium-cli.js"
  },
  "main": "main.js",
  "exports": {
    "./sdk": "./lib/plugin_sdk.js"
  },
  "types": "./lib/plugin_sdk.d.ts",
  "scripts": {
    "start": "node bin/atrium-cli.js run",
    "atrium": "node bin/atrium-cli.js",
    "test": "node bin/atrium-cli.js test",
    "pack:plugin": "node bin/atrium-cli.js pack plugin",
    "installer": "node bin/atrium-cli.js installer"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@lotus-gui/core": "file:../lotus/packages/lotus-core"
  }
}
